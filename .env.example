# Local port the web server listens on
PORT=3000

# Secret API key from Anthropic Console (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Secret key used to sign and verify user session tokens
JWT_SECRET=change_me_to_a_random_secret_string

# Workplace invite code required during colleague registration
TEAM_ACCESS_CODE=welcome123

# Allowed company email domains (* for any, or e.g. company.com)
ALLOWED_EMAIL_DOMAINS=*

# Default Claude model for new conversations
DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Maximum output tokens generated per single response
MAX_TOKENS_PER_REQUEST=4096

# Safety token budget ceiling allowed per user per day
DAILY_USER_TOKEN_LIMIT=150000

# Time window in minutes for rate limiting checks
RATE_LIMIT_WINDOW_MINUTES=15

# Maximum chat requests allowed per user within the time window
RATE_LIMIT_MAX_REQUESTS=60
